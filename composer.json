{
  "name": "cornell-custom-dev/laravel-ldap",
  "description": "A Laravel package for connecting to Cornell LDAP resources",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.2",
    "spatie/laravel-package-tools": "^1.16",
    "ext-ldap": "*"
  },
  "require-dev": {
    "orchestra/testbench": "^7.30",
    "phpunit/phpunit": "^9.6",
    "laravel/pint": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "CornellCustomDev\\LaravelLdap\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CornellCustomDev\\LaravelLdap\\Tests\\": "tests"
    }
  },
  "scripts": {
    "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "CornellCustomDev\\LaravelLdap\\LdapServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
